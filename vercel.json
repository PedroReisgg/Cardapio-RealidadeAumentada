{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    { "source": "/models/(.*)", "headers": [{ "key": "Content-Type", "value": "model/gltf-binary" }, { "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(img|vendor)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), xr-spatial-tracking=(self)" }] }
  ]
}
